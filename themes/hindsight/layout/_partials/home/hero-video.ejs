<div
	id="video-container"
	class="relative w-full h-auto xl:h-[calc(100vh-80px)] overflow-hidden bg-black"
></div>

<script>
	window.addEventListener("DOMContentLoaded", () => {
		const container = document.getElementById("video-container");
		const video = document.createElement("video");

		video.muted = true;
		video.defaultMuted = true;
		video.playsInline = true;
		video.autoplay = true;
		video.loop = true;

		// Set attributes too for safety
		video.setAttribute("muted", "");
		video.setAttribute("autoplay", "");
		video.setAttribute("loop", "");
		video.setAttribute("playsinline", "");

		// Responsive classes - different behavior for mobile vs desktop
		video.className =
			"w-full h-auto transition-opacity duration-500 " +
			"max-[720px]:w-full max-[720px]:h-auto " +
			"min-[721px]:xl:absolute min-[721px]:xl:inset-0 min-[721px]:xl:w-full min-[721px]:xl:h-full min-[721px]:xl:object-cover " +
			"opacity-0";

		// Function to set the appropriate video source based on screen size
		function setVideoSource() {
			const isMobile = window.innerWidth <= 720;
			const videoSource = isMobile
				? "/videos/hero-video-mobile.mp4"
				: "/videos/hero-video.mp4";

			// Only change source if it's different from current
			if (video.src !== videoSource) {
				video.src = videoSource;
				video.load();
				video.play().catch((e) => {
					console.warn("Video autoplay blocked or error:", e);
				});
			}
		}

		// Set initial video source
		setVideoSource();

		container.appendChild(video);

		// Once enough is buffered, fade in
		video.addEventListener("canplaythrough", () => {
			video.classList.add("opacity-100");
		});

		// Handle resize events for responsive behavior
		let resizeTimeout;
		window.addEventListener("resize", () => {
			clearTimeout(resizeTimeout);
			resizeTimeout = setTimeout(() => {
				setVideoSource();
			}, 250); // Debounce resize events
		});
	});
</script>
