<!-- Contact Form -->
<div class="bg-white p-6 h-full">
	<form
		action="https://formspree.io/f/xdkzqnld"
		method="POST"
		id="contactForm"
		class="space-y-6 h-full flex flex-col"
	>
		<div>
			<label for="name" class="block mb-2 text-sm font-medium text-gray-900"
				>Your name</label
			>
			<input
				type="text"
				id="name"
				name="name"
				class="bg-white border border-gray-300 text-gray-900 text-sm focus:ring-black focus:border-black block w-full p-2.5"
				placeholder="Your Name"
				required
			/>
		</div>
		<div>
			<label for="email" class="block mb-2 text-sm font-medium text-gray-900"
				>Your email</label
			>
			<input
				type="email"
				id="email"
				name="email"
				class="bg-white border border-gray-300 text-gray-900 text-sm focus:ring-black focus:border-black block w-full p-2.5"
				placeholder="your@email.com"
				required
			/>
		</div>
		<div>
			<label for="subject" class="block mb-2 text-sm font-medium text-gray-900"
				>Subject</label
			>
			<input
				type="text"
				id="subject"
				name="subject"
				class="bg-white border border-gray-300 text-gray-900 text-sm focus:ring-black focus:border-black block w-full p-2.5"
				placeholder="Subject"
				required
			/>
		</div>
		<div class="flex-grow">
			<label for="message" class="block mb-2 text-sm font-medium text-gray-900"
				>Your message</label
			>
			<textarea
				id="message"
				name="message"
				rows="4"
				class="bg-white border border-gray-300 text-gray-900 text-sm focus:ring-black focus:border-black block w-full p-2.5 h-full"
				placeholder="How can we help..."
				required
			></textarea>
		</div>
		<div class="mt-8">
			<button
				type="submit"
				class="text-white bg-black hover:bg-gray-800 focus:ring-4 focus:ring-gray-300 font-medium text-sm px-5 py-2.5 focus:outline-none"
			>
				Send message
			</button>
		</div>

		<!-- Success Message -->
		<div
			id="formSuccess"
			class="hidden mt-4 text-sm text-gray-900 bg-green-50 border border-green-200 rounded-lg p-4"
			role="alert"
		>
			<div class="flex">
				<svg
					class="flex-shrink-0 w-4 h-4 mt-0.5 text-green-600"
					fill="currentColor"
					viewBox="0 0 20 20"
				>
					<path
						fill-rule="evenodd"
						d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
						clip-rule="evenodd"
					></path>
				</svg>
				<div class="ml-3">
					<span class="font-medium">Thank you for your message!</span> We will
					get back to you as soon as possible.
				</div>
			</div>
		</div>

		<!-- Error Message -->
		<div
			id="formError"
			class="hidden mt-4 text-sm text-gray-900 bg-red-50 border border-red-200 rounded-lg p-4"
			role="alert"
		>
			<div class="flex">
				<svg
					class="flex-shrink-0 w-4 h-4 mt-0.5 text-red-600"
					fill="currentColor"
					viewBox="0 0 20 20"
				>
					<path
						fill-rule="evenodd"
						d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
						clip-rule="evenodd"
					></path>
				</svg>
				<div class="ml-3">
					<span class="font-medium">Oops!</span> Something went wrong. Please
					try again later.
				</div>
			</div>
		</div>

		<!-- Loading Message -->
		<div
			id="formLoading"
			class="hidden mt-4 text-sm text-gray-900 bg-blue-50 border border-blue-200 rounded-lg p-4"
			role="alert"
		>
			<div class="flex">
				<span role="status">
					<svg
						aria-hidden="true"
						class="w-4 h-4 me-2 text-gray-200 animate-spin fill-blue-600"
						viewBox="0 0 100 101"
						fill="none"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z"
							fill="currentColor"
						/>
						<path
							d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z"
							fill="currentFill"
						/>
					</svg>
					<span class="sr-only">Loading...</span>
				</span>
				<span class="font-medium">Sending...</span> Please wait while we send
				your message.
			</div>
		</div>
	</form>
</div>

<script>
	// Handle form submission
	document
		.getElementById("contactForm")
		.addEventListener("submit", async function (e) {
			e.preventDefault();

			// Hide any existing messages
			document.getElementById("formSuccess").classList.add("hidden");
			document.getElementById("formError").classList.add("hidden");
			document.getElementById("formLoading").classList.remove("hidden");

			// Get form data
			const formData = new FormData(this);

			try {
				const response = await fetch(this.action, {
					method: "POST",
					body: formData,
					headers: {
						Accept: "application/json",
					},
				});

				// Hide loading message
				document.getElementById("formLoading").classList.add("hidden");

				if (response.ok) {
					// Show success message
					document.getElementById("formSuccess").classList.remove("hidden");
					this.reset();
				} else {
					// Show error message
					document.getElementById("formError").classList.remove("hidden");
				}
			} catch (error) {
				console.error("Error submitting form:", error);
				// Hide loading message
				document.getElementById("formLoading").classList.add("hidden");
				// Show error message
				document.getElementById("formError").classList.remove("hidden");
			}
		});
</script>
