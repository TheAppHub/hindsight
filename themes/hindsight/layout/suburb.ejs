<main class="pb-16 lg:pb-24 antialiased">
	<header class="py-12">
		<div class="px-4 mx-auto w-full max-w-screen-xl text-center">
			<h1
				class="mx-auto mb-4 max-w-2xl text-2xl font-extrabold leading-none text-gray-900 sm:text-3xl lg:text-4xl"
			>
				<%= page.title %>
			</h1>
			<p class="text-lg font-normal text-gray-500">
				Full-Service Creative Marketing Agency for <%= page.suburb %> and
				surrounding suburbs
			</p>
		</div>
	</header>
	<section
		class="flex relative z-20 justify-between px-4 mx-auto max-w-screen-xl rounded"
	>
		<article class="format w-full max-w-none">
			<section>
				<p class="lead"><%= page.description %></p>
				<%- page.content %>
			</section>
			<%- partial('_partials/suburbs/contact', {suburb: page.suburb}) %>
		</article>

		<!-- Sidebar -->
		<%- partial('_partials/suburbs/sidebar', {contact: true, info: false,
		latestPosts: true}) %>
	</section>
</main>

<!-- Projects  -->
<%- partial('_partials/suburbs/latest-projects') %>

<!-- Local References -->
<%- partial('_partials/suburbs/local-references', {suburb: page.suburb}) %>

<!-- Random FAQs  -->
<%- partial('_partials/suburbs/random-faqs', {suburb: page.suburb}) %>
